{
  "manifest_version": 3,
  "name": "Cookie Reader",
  "version": "1.0",
  "description": "Citeste si printeaza cookie-urile oricarui site",
  "permissions": ["cookies", "tabs", "activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cookie Reader"
  }
}
